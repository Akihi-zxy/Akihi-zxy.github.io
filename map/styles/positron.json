{
 "version": 8,
 "name": "positron-offline-raster",
 "metadata": {
  "offline": true,
  "tiles": "OSM France raster, greyscale paint"
 },
 "glyphs": "/map/fonts/{fontstack}/{range}.pbf",
 "sprite": "/map/sprites/ofm_f384/ofm",
 "sources": {
  "osm": {
   "type": "raster",
   "tiles": [
    "/map/tiles/osm/{z}/{x}/{y}.png"
   ],
   "tileSize": 256,
   "minzoom": 3,
   "maxzoom": 14,
   "attribution": "© OpenStreetMap contributors"
  }
 },
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#f4f3f0"
   }
  },
  {
   "id": "osm",
   "type": "raster",
   "source": "osm",
   "paint": {
    "raster-saturation": -0.85,
    "raster-contrast": 0.04,
    "raster-brightness-max": 0.99,
    "raster-opacity": 1
   }
  }
 ]
}